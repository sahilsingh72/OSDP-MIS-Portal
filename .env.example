APP_NAME="OSDP MIS Portal"
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_URL=https://mis.osdp.odisha.gov.in

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

PHP_CLI_SERVER_WORKERS=4
BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_LEVEL=info

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=osdp_db
DB_USERNAME=osdp_db_user
DB_PASSWORD=Secure_Database_Password_Here

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=true
SESSION_PATH=/
SESSION_DOMAIN=null
SESSION_SECURE_COOKIE=true

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database
CACHE_STORE=database

# Private Storage Root
EVIDENCE_STORAGE_PATH=/var/www/osdp_evidence_private

MAIL_MAILER=smtp
MAIL_HOST=smtp.mail.gov.in
MAIL_PORT=587
MAIL_USERNAME=mis-alerts@osdp.odisha.gov.in
MAIL_PASSWORD=
MAIL_ENCRYPTION=tls
MAIL_FROM_ADDRESS="no-reply@osdp.odisha.gov.in"
MAIL_FROM_NAME="OSDP MIS Portal"

VITE_APP_NAME="${APP_NAME}"
